{
  "name": "banco-valor-digital",
  "version": "0.1.0",
  "private": true,
  "description": "Projeto piloto do website institucional e plataforma digital do Banco Valor Digital.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "node scripts/setup-env.mjs && prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-three/fiber": "9.7.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "12.43.0",
    "jose": "^6.2.10",
    "lucide-react": "1.34.0",
    "next": "15.5.23",
    "otplib": "^13.5.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/three": "0.185.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
