# Banco de dados. SQLite por padrão (nenhuma infraestrutura necessária).
# Para PostgreSQL: postgresql://usuario:senha@host:5432/valor?schema=public
DATABASE_URL="file:./dev.db"

# Segredo de assinatura das sessões. Em produção, gere 32 bytes aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-este-valor"
